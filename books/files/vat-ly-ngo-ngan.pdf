     <rdf:li>BATTERY, INVENTOR OF, WEDDING</rdf:li>
     <rdf:li>ALKALINE BATTERY, INVENTOR</rdf:li>
     <rdf:li>ELECTRICAL ENGINEER, EDISON</rdf:li>
