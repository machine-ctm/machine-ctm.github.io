<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 5.3-c011 66.145661, 2012/02/06-14:56:27        ">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
    xmlns:xmp="http://ns.adobe.com/xap/1.0/"
    xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
    xmlns:stRef="http://ns.adobe.com/xap/1.0/sType/ResourceRef#"
    xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#"
    xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
   photoshop:Headline="Van de Graaff generator and Faraday cage, Boston"
   photoshop:Credit="Science Photo Library"
   photoshop:Source="PMZ"
   photoshop:ColorMode="1"
   photoshop:ICCProfile="Dot Gain 20%"
   xmp:CreateDate="2006-05-25T17:59:05+01:00"
   xmp:ModifyDate="2013-02-27T11:21:32+07:00"
   xmp:MetadataDate="2013-02-27T11:21:32+07:00"
   xmp:CreatorTool="Adobe Photoshop CS2 Macintosh"
   xmpMM:DocumentID="adobe:docid:photoshop:7cabe4ce-edaa-11da-8240-cef7cfd326c1"
   xmpMM:InstanceID="xmp.iid:1C42970E9580E2118967C4D3CFACF19B"
   xmpMM:OriginalDocumentID="adobe:docid:photoshop:7cabe4ce-edaa-11da-8240-cef7cfd326c1"
   xmpRights:WebStatement="http://www.sciencephoto.com"
   xmpRights:Marked="False"
   dc:format="image/tiff">
   <xmpMM:DerivedFrom
    stRef:instanceID="uuid:9e9516c5-3857-11d7-9fb6-939fd97a24b6"
    stRef:documentID="adobe:docid:photoshop:8428e587-3854-11d7-9fb6-939fd97a24b6"/>
   <xmpMM:History>
    <rdf:Seq>
     <rdf:li
      stEvt:action="saved"
      stEvt:instanceID="xmp.iid:1C42970E9580E2118967C4D3CFACF19B"
      stEvt:when="2013-02-27T11:21:32+07:00"
      stEvt:softwareAgent="Adobe Photoshop CS6 (Windows)"
      stEvt:changed="/"/>
    </rdf:Seq>
   </xmpMM:History>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Safety of a Faraday cage. Amid a flurry of electric discharge, a museum worker demonstrates the safety of a Faraday cage. The cage is designed such that no discharges will reach inside. The distance between the bars means that a discharge will always find it easier to hit a bar than pass in between to another object. The person inside is therefore protected. The discharge is created by a vast Van de Graaff generator (columns and spheres) behind the cage, with a potential difference of 2.5 million volts. The generator was built by Van de Graaff in 1931, and is now at the Boston Museum of Science.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">T194/273</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">CREDIT: PETER MENZEL/SCIENCE PHOTO LIBRARY</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>VAN DE GRAAFF GENERATOR</rdf:li>
     <rdf:li>FARADAY CAGE, LIGHTNING</rdf:li>
     <rdf:li>STATIC ELECTRICITY, VAN DE GRA</rdf:li>
     <rdf:li>ELECTRICITY, VAN DE GRAAFF GEN</rdf:li>
     <rdf:li>GENERATOR, VAN DE GRAAFF</rdf:li>
     <rdf:li>ELECTRICITY, ELECTRICAL</rdf:li>
     <rdf:li>PHYSICS, ENERGY, INDUSTRY</rdf:li>
     <rdf:li>TECHNOLOGY</rdf:li>
    </rdf:Bag>
   </dc:subject>
  </rdf:Description>
 </rdf:RDF>
