   dc:format="image/tiff"
   xmpRights:Marked="False">
   <photoshop:SupplementalCategories>
    <rdf:Bag>
     <rdf:li>Science and Nature Technology an</rdf:li>
     <rdf:li>Science and Nature Astronomy</rdf:li>
     <rdf:li>Artistic Representations Portrai</rdf:li>
     <rdf:li>People Famous People</rdf:li>
    </rdf:Bag>
   </photoshop:SupplementalCategories>
   <xmpMM:History>
    <rdf:Seq>
     <rdf:li
      stEvt:action="saved"
      stEvt:instanceID="xmp.iid:578800349580E2118967C4D3CFACF19B"
      stEvt:when="2013-02-27T11:22:16+07:00"
      stEvt:softwareAgent="Adobe Photoshop CS6 (Windows)"
      stEvt:changed="/"/>
    </rdf:Seq>
   </xmpMM:History>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Kepler and Brahe at work together (c1600), c1870. German astronomer Johannes Kepler (1571-1630), left, with the Danish astronomer Tycho Brahe (1564-1601) in Benatky Observatory near Prague while employed  by emperor Rudolf II. In 1609, Kepler published the results of Brahe's calculations of the orbit of Mars, which showed that the planet did not move uniformly in circles, but in ellipses. This celebrated work also outlined Kepler's first and second laws governing planetary motion. The formulation of his third law ten years later, which connected the periods of revolution of the planets with their mean distances from the Sun, completed his researches in dynamical astronomy. From 'Vies des Savants Illustres' (Illustrated Lives of the Scientists) by Louis Figuier. (Paris, c1870).   *** Local Caption *** Kepler and Brahe at work together (c1600), c1870.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Oxford Science Archive</rdf:li>
    </rdf:Seq>
   </dc:creator>
