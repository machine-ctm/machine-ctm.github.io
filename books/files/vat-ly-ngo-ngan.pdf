   photoshop:Headline="Thomas Edison being too busy to attend his wedding"
   photoshop:Credit="Science Photo Library"
   photoshop:Source="IML"
   photoshop:ColorMode="8"
   xmp:CreateDate="2006-06-30T13:14:29+08:00"
