     <rdf:li>PI-VALUE, ARCHIMEDES</rdf:li>
     <rdf:li>BATH, ARCHIMEDES IN</rdf:li>
     <rdf:li>CROWN, ARCHIMEDES IN BATH</rdf:li>
     <rdf:li>ARCHIMEDES' PRINCIPLE, PROPOSE</rdf:li>
     <rdf:li>HYDROSTATICS, ARCHIMEDES</rdf:li>
     <rdf:li>PORTRAIT, PORTRAITS</rdf:li>
     <rdf:li>SURNAME A</rdf:li>
    </rdf:Bag>
