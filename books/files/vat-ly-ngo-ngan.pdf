<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 5.3-c011 66.145661, 2012/02/06-14:56:27        ">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
    xmlns:xmp="http://ns.adobe.com/xap/1.0/"
    xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
    xmlns:stRef="http://ns.adobe.com/xap/1.0/sType/ResourceRef#"
    xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#"
    xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
   photoshop:Headline="Cartoon of Isaac Newton, celebrating Principia"
   photoshop:Credit="Science Photo Library"
   photoshop:Source="RAI"
   photoshop:ColorMode="1"
   photoshop:ICCProfile="Dot Gain 20%"
   xmp:CreateDate="2006-05-25T17:48:21+01:00"
   xmp:ModifyDate="2013-02-27T11:22:22+07:00"
   xmp:MetadataDate="2013-02-27T11:22:22+07:00"
   xmp:CreatorTool="Adobe Photoshop CS2 Macintosh"
   xmpMM:DocumentID="adobe:docid:photoshop:ee554f23-eda8-11da-8240-cef7cfd326c1"
   xmpMM:InstanceID="xmp.iid:752820469580E2118967C4D3CFACF19B"
   xmpMM:OriginalDocumentID="adobe:docid:photoshop:ee554f23-eda8-11da-8240-cef7cfd326c1"
   xmpRights:WebStatement="http://www.sciencephoto.com"
   xmpRights:Marked="False"
   dc:format="image/tiff">
   <xmpMM:DerivedFrom
    stRef:instanceID="uuid:9527c802-2978-11d8-908c-9f2019d1f656"
    stRef:documentID="adobe:docid:photoshop:9527c7fd-2978-11d8-908c-9f2019d1f656"/>
   <xmpMM:History>
    <rdf:Seq>
     <rdf:li
      stEvt:action="saved"
      stEvt:instanceID="xmp.iid:752820469580E2118967C4D3CFACF19B"
      stEvt:when="2013-02-27T11:22:22+07:00"
      stEvt:softwareAgent="Adobe Photoshop CS6 (Windows)"
      stEvt:changed="/"/>
    </rdf:Seq>
   </xmpMM:History>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Cartoon to celebrate the 300th anniversary of thepublication of Isaac Newton's great work,Philosophiae Naturalis Principia Mathematica('Mathematical Principles of Natural Philosophy'),in 1687. Newton (1642-1727) developed the theoryof universal gravitation in the book. According tothe well-known story, the idea of universalgravitation first came to him when, at the age of22, he was sitting in the garden of his familyhome at Woolsthorpe, Lincolnshire, and saw anapple fall to the ground. Newton himself isreported to have told this story to friends in1726-1727, near the end of his life.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">H414/008</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">CREDIT: MIKKI RAIN/SCIENCE PHOTO LIBRARY</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>NEWTON, ISAAC, CARTOON</rdf:li>
     <rdf:li>PRINCIPIA, ANNIVERSARY ART</rdf:li>
     <rdf:li>PORTRAIT, PORTRAITS</rdf:li>
     <rdf:li>SURNAME N</rdf:li>
    </rdf:Bag>
   </dc:subject>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>

