<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 5.3-c011 66.145661, 2012/02/06-14:56:27        ">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
    xmlns:xmp="http://ns.adobe.com/xap/1.0/"
    xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
    xmlns:stRef="http://ns.adobe.com/xap/1.0/sType/ResourceRef#"
    xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#"
    xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
   photoshop:Headline="Historical artwork of a man holding a Leyden jar"
   photoshop:Credit="Science Photo Library"
   photoshop:Source="IML"
   photoshop:ColorMode="1"
   photoshop:ICCProfile="Dot Gain 20%"
   xmp:CreateDate="2006-05-25T18:02:48+01:00"
   xmp:ModifyDate="2013-02-27T11:21:50+07:00"
   xmp:MetadataDate="2013-02-27T11:21:50+07:00"
   xmp:CreatorTool="Adobe Photoshop CS2 Macintosh"
   xmpMM:DocumentID="adobe:docid:photoshop:e0a3a439-edaa-11da-8240-cef7cfd326c1"
   xmpMM:InstanceID="xmp.iid:4F8800349580E2118967C4D3CFACF19B"
   xmpMM:OriginalDocumentID="adobe:docid:photoshop:e0a3a439-edaa-11da-8240-cef7cfd326c1"
   xmpRights:WebStatement="http://www.sciencephoto.com"
   xmpRights:Marked="False"
   dc:format="image/tiff">
   <xmpMM:DerivedFrom
    stRef:instanceID="uuid:50c3161d-1dd4-11d9-99f0-827dd7c4f269"
    stRef:documentID="adobe:docid:photoshop:50c31618-1dd4-11d9-99f0-827dd7c4f269"/>
   <xmpMM:History>
    <rdf:Seq>
     <rdf:li
      stEvt:action="saved"
      stEvt:instanceID="xmp.iid:4F8800349580E2118967C4D3CFACF19B"
      stEvt:when="2013-02-27T11:21:50+07:00"
      stEvt:softwareAgent="Adobe Photoshop CS6 (Windows)"
      stEvt:changed="/"/>
    </rdf:Seq>
   </xmpMM:History>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Leyden jar. Historical artwork of a man (at left) holding a Leyden jar, the earliest type of capacitor. A capacitor is a device for storing electric charge and the jar is storing electricity generated by the spherical electrostatic generator at right. The Leyden jar contains water and a brass rod. The man holding it acts as an earthed conductor. Now rarely used outside of the classroom, the Leyden jar was invented at the University of Leyden in the Netherlands in 1746. </rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">V510/029</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">CREDIT: SCIENCE PHOTO LIBRARY</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>CAPACITOR, ELECTROSTATIC, HIST</rdf:li>
     <rdf:li>LEYDEN JAR, HISTORICAL ARTWORK</rdf:li>
     <rdf:li>ELECTROSTATIC CAPACITOR, HISTO</rdf:li>
     <rdf:li>ELECTROSTATIC GENERATOR, HISTO</rdf:li>
     <rdf:li>ELECTRICITY GENERATION, HISTOR</rdf:li>
     <rdf:li>ELECTRICITY STORAGE, HISTORY</rdf:li>
     <rdf:li>GENERATOR, ELECTROSTATIC, HIST</rdf:li>
     <rdf:li>ELECTRICAL, ELECTRICITY</rdf:li>
     <rdf:li>PHYSICS</rdf:li>
     <rdf:li>HISTORY OF SCIENCE</rdf:li>
     <rdf:li>TECHNOLOGY, HISTORICAL</rdf:li>
    </rdf:Bag>
   </dc:subject>
  </rdf:Description>
 </rdf:RDF>
