    xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#"
    xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:tiff="http://ns.adobe.com/tiff/1.0/"
    xmlns:exif="http://ns.adobe.com/exif/1.0/"
   photoshop:Headline="Engraving of Isaac Newton and his notes burning"
   photoshop:Credit="Science Photo Library"
   photoshop:Source="IML"
   photoshop:ColorMode="8"
   xmp:CreateDate="2006-06-30T13:22:10+08:00"
   xmp:ModifyDate="2013-02-28T11:24:15+07:00"
   xmp:MetadataDate="2013-02-28T11:24:15+07:00"
   xmp:CreatorTool="Adobe Photoshop CS5.1 Windows"
   xmpMM:DocumentID="uuid:B62AC61909CC11DB8C12DB1A48ADC2C3"
   xmpMM:InstanceID="xmp.iid:4845D0E65D81E211BBADD65F5BEC3FED"
   xmpMM:OriginalDocumentID="uuid:B62AC61909CC11DB8C12DB1A48ADC2C3"
   xmpRights:WebStatement="http://www.sciencephoto.com"
   xmpRights:Marked="False"
   dc:format="application/vnd.adobe.photoshop"
   tiff:ImageWidth="5083"
   tiff:ImageLength="3495"
   tiff:Compression="1"
   tiff:PhotometricInterpretation="5"
   tiff:Orientation="1"
   tiff:SamplesPerPixel="4"
   tiff:PlanarConfiguration="1"
   tiff:XResolution="3500000/10000"
   tiff:YResolution="3500000/10000"
   tiff:ResolutionUnit="2"
   exif:ColorSpace="65535"
   exif:PixelXDimension="1809"
   exif:PixelYDimension="1382">
   <xmpMM:DerivedFrom
    stRef:instanceID="adobe:docid:photoshop:2eec8f4d-eda9-11da-8240-cef7cfd326c1"
    stRef:documentID="adobe:docid:photoshop:2eec8f4d-eda9-11da-8240-cef7cfd326c1"/>
   <xmpMM:History>
    <rdf:Seq>
     <rdf:li
      stEvt:action="saved"
      stEvt:instanceID="xmp.iid:EECA2DEE9380E2118967C4D3CFACF19B"
      stEvt:when="2013-02-27T11:17:42+07:00"
      stEvt:softwareAgent="Adobe Photoshop CS6 (Windows)"
      stEvt:changed="/"/>
     <rdf:li
      stEvt:action="saved"
      stEvt:instanceID="xmp.iid:4845D0E65D81E211BBADD65F5BEC3FED"
      stEvt:when="2013-02-28T11:24:15+07:00"
      stEvt:softwareAgent="Adobe Photoshop CS5.1 Windows"
      stEvt:changed="/"/>
    </rdf:Seq>
   </xmpMM:History>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Isaac Newton. Engraving of Sir Isaac Newton (1642- 1727), English physicist and mathematician, discovering that his notes on optics are burning. This incident, in 1692, was blamed for a nervous breakdown that Newton suffered and his subsequent retirment for two years. The accident happened as Newton was preparing his book on light, Opticks (1704). Whilst attending a church service in Trinity College at Cambridge University, Newton's dog, Diamond, knocked over a lighted candle onto several years' notes on optical experiments. On discovering this, Newton alledgedly exclaimed 'Oh Diamond, Diamond, little do you know the mischief you have done me'. </rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">H414/072</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">CREDIT: SCIENCE PHOTO LIBRARY</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>NEWTON, ISAAC</rdf:li>
     <rdf:li>OPTICKS, NOTES BURNING</rdf:li>
     <rdf:li>OPTICS, NEWTON</rdf:li>
     <rdf:li>PHYSICIST, NEWTON, SIR ISAAC</rdf:li>
     <rdf:li>NEWTON, ISAAC, BREAKDOWN CAUSE</rdf:li>
     <rdf:li>PORTRAIT, PORTRAITS</rdf:li>
     <rdf:li>SURNAME N</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <tiff:BitsPerSample>
    <rdf:Seq>
     <rdf:li>8</rdf:li>
     <rdf:li>8</rdf:li>
     <rdf:li>8</rdf:li>
     <rdf:li>8</rdf:li>
    </rdf:Seq>
   </tiff:BitsPerSample>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>

