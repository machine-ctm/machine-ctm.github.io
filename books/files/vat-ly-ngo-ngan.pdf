<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 5.3-c011 66.145661, 2012/02/06-14:56:27        ">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about=""
    xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/"
    xmlns:xmp="http://ns.adobe.com/xap/1.0/"
    xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
    xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#"
    xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
   photoshop:Headline="Durer's world map, 1515"
   photoshop:Credit="Science Photo Library"
   photoshop:Source="STE"
   photoshop:ColorMode="1"
   photoshop:ICCProfile="Dot Gain 20%"
   xmp:CreateDate="2006-05-25T17:38:36+01:00"
   xmp:ModifyDate="2013-02-27T11:22:18+07:00"
   xmp:MetadataDate="2013-02-27T11:22:18+07:00"
   xmp:CreatorTool="Adobe Photoshop CS2 Macintosh"
   xmpMM:DocumentID="adobe:docid:photoshop:8161eb3a-eda7-11da-8240-cef7cfd326c1"
   xmpMM:InstanceID="xmp.iid:722820469580E2118967C4D3CFACF19B"
   xmpMM:OriginalDocumentID="adobe:docid:photoshop:8161eb3a-eda7-11da-8240-cef7cfd326c1"
   xmpRights:WebStatement="http://www.sciencephoto.com"
   xmpRights:Marked="False"
   dc:format="image/tiff">
   <xmpMM:History>
    <rdf:Seq>
     <rdf:li
      stEvt:action="saved"
      stEvt:instanceID="xmp.iid:722820469580E2118967C4D3CFACF19B"
      stEvt:when="2013-02-27T11:22:18+07:00"
      stEvt:softwareAgent="Adobe Photoshop CS6 (Windows)"
      stEvt:changed="/"/>
    </rdf:Seq>
   </xmpMM:History>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Durer's world map, 1515. Albrecht Durer (1471-1528) was a German artist. His skillful use of perspective and mathematical proportions made him one of the outstanding artistic figures of the early 16th century. This world map is based on Ptolemy's map plus extensions from Behaim's Globe of 1492. It is the first known perspective drawing of the entire Earth as a sphere, and was published in 1515, using the best maps of the time in collaboration with Nuremberg astronomer Johann Stabius. The map shows the world surrounded by 12 wind gods. Taken from Dr Willi Kurth's The Complete Woodcuts of Albrecht Durer (1936). </rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">E056/083</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">CREDIT: SHEILA TERRY/SCIENCE PHOTO LIBRARY</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>MAP</rdf:li>
     <rdf:li>HISTORY</rdf:li>
     <rdf:li>CARTOGRAPHY</rdf:li>
     <rdf:li>GEOGRAPHY</rdf:li>
     <rdf:li>WOODCUT</rdf:li>
     <rdf:li>ARTWORK</rdf:li>
     <rdf:li>DISCOVERY</rdf:li>
     <rdf:li>EXPLORATION</rdf:li>
     <rdf:li>TRAVEL</rdf:li>
     <rdf:li>KNOWLEDGE</rdf:li>
     <rdf:li>JOURNEY</rdf:li>
     <rdf:li>LANDSCAPE</rdf:li>
     <rdf:li>RENAISSANCE</rdf:li>
     <rdf:li>16TH CENTURY</rdf:li>
     <rdf:li>1500S</rdf:li>
     <rdf:li>1515</rdf:li>
     <rdf:li>GEOGRAPHICAL,ILLUSTRATION</rdf:li>
     <rdf:li>HORIZONTAL</rdf:li>
     <rdf:li>EARTH SCIENCE,SCIENCES</rdf:li>
     <rdf:li>HISTORICAL, HISTORY</rdf:li>
     <rdf:li>MAPPING,MAPS,OLD,ANCIENT</rdf:li>
     <rdf:li>MAP, CARTOGRAPHY</rdf:li>
     <rdf:li>ATLAS,EARTH,GLOBE,SPHERE</rdf:li>
     <rdf:li>PTOLOMEY,BEHAIM'S GLOBE</rdf:li>
