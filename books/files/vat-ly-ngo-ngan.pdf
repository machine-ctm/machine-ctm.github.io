   photoshop:Headline="Removing Hamburger from Radarange"
   photoshop:Instructions="For latest restrictions check www.corbis.com"
   photoshop:Credit="Â© Bettmann/CORBIS"
   photoshop:TransmissionReference="12253705"
   photoshop:DateCreated="0004-01-01"
